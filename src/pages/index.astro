---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import DownloadButton from '../components/DownloadButton.astro';
import editing from '../assets/app/graphite-editing.png';
import history from '../assets/app/graphite-history.png';
import light from '../assets/app/graphite-light.png';
import dark from '../assets/app/graphite-dark.png';
import paper from '../assets/app/paper-ink-light.png';
import PowerShowcase from '../components/PowerShowcase.astro';
import ExampleCard from '../components/ExampleCard.astro';
import FinalDownload from '../components/FinalDownload.astro';
import GuideCards from '../components/GuideCards.astro';
import { site } from '../data/site';
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Sumi: Scientific Calculator',
  operatingSystem: 'Android',
  applicationCategory: 'UtilitiesApplication',
  description: site.description,
  url: site.origin,
  installUrl: site.android.url,
  image: `${site.origin}/og.png`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
  author: { '@type': 'Person', name: 'Tomu Ozawa' },
};
const appearances = [
  { image: light, label: 'Graphite', mode: 'Light · the default palette' },
  { image: dark, label: 'Graphite', mode: 'Dark · for a quieter screen' },
  { image: paper, label: 'Paper & Ink', mode: 'Light · a little warmth' },
];
---

<SiteLayout
  title="Sumi — Free Scientific Calculator for Android"
  structuredData={appSchema}
>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="tiny-rule"></span> FAMILIAR BY DESIGN
      </p>
      <h1 id="hero-title">
        Your scientific calculator.
        <br />
        <span>Always with you.</span>
      </h1>
      <p class="hero-description">
        Familiar controls, readable maths, and a carefully considered interface.
        For everyday calculations, study, and work.
      </p>
      <div id="hero-download" class="hero-download">
        <DownloadButton campaign="home" />
        <p class="hero-reassurance">Free. No ads. Calculations work offline.</p>
        <p class="coming-soon">Available on Android. iPhone coming soon.</p>
      </div>
      <a href="#features" class="text-link hero-explore">
        Take a closer look <span aria-hidden="true">↓</span>
      </a>
    </div>
    <figure class="hero-stage">
      <div class="hero-phone">
        <Image
          src={editing}
          alt="Sumi in Graphite, with a familiar scientific keypad, editable fractions and a live answer of 29/4"
          widths={[360, 540, 720]}
          sizes="(max-width: 767px) 280px, (max-width: 1023px) 270px, 310px"
          width={310}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>Your everyday maths. A familiar place for it.</figcaption>
    </figure>
  </section>

  <div class="trust-strip wrap" aria-label="Free and private">
    <p>
      Made to be useful.
      <br />
      <strong>Free to make it yours.</strong>
    </p>
    <span>Every feature free</span>
    <span>No ads</span>
    <span>No account</span>
    <span>Works offline</span>
  </div>

  <section
    id="features"
    class="section wrap natural-section"
    aria-labelledby="natural-title"
  >
    <div class="natural-copy">
      <p class="eyebrow">01 / MATHS YOU CAN READ</p>
      <h2 id="natural-title">
        Just like your notebook.
        <br />
        <span class="muted-heading">Much easier to edit.</span>
      </h2>
      <p class="section-lead">
        Fractions stack. Roots stretch. Powers sit where they should. Move
        through an expression and change just the part you need.
      </p>
      <div class="feature-detail">
        <span class="detail-number">↳</span>
        <div>
          <h3>See your answer take shape</h3>
          <p>
            A live preview shows the result as you type, for supported
            calculations.
          </p>
        </div>
      </div>
      <div class="feature-detail">
        <span class="detail-number">=</span>
        <div>
          <h3>Keep the exact answer</h3>
          <p>
            Reduced fractions, surds and multiples of π where supported. After
            calculating, tap S⇔D to switch to a decimal.
          </p>
        </div>
      </div>
      <a class="text-link" href="/guides/exact-answers/">
        Explore exact answers <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="example-stage">
      <ExampleCard />
      <p class="example-caption">
        Try a few examples. The same exact answers you’ll find in Sumi.
      </p>
    </div>
  </section>

  <PowerShowcase />

  <section
    class="everyday-section section wrap"
    aria-labelledby="everyday-title"
  >
    <div class="history-stage">
      <Image
        src={history}
        alt="Sumi’s history drawer showing recent calculations ready to recall and edit"
        widths={[360, 540, 720]}
        sizes="(max-width: 767px) 260px, 290px"
        width={290}
        loading="lazy"
      />
    </div>
    <div class="everyday-copy">
      <p class="eyebrow">03 / READY FOR YOUR NEXT THOUGHT</p>
      <h2 id="everyday-title">
        Pick up where
        <br />
        you left off.
      </h2>
      <p class="section-lead">
        Your recent calculations stay close. Recall an expression from history,
        change a value, and carry on.
      </p>
      <div class="feature-detail">
        <span class="detail-number">01</span>
        <div>
          <h3>Keep useful results</h3>
          <p>
            Long-press a result to copy it. Use stored variables and Ans when
            your next calculation builds on the last.
          </p>
        </div>
      </div>
      <div class="feature-detail">
        <span class="detail-number">02</span>
        <div>
          <h3>Find the function you need</h3>
          <p>
            Familiar SHIFT and ALPHA controls, with optional secondary key
            labels. Adjust key vibration and live answers to suit you.
          </p>
        </div>
      </div>
      <a class="text-link" href="/support/">
        Get to know the controls <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="appearance-section" aria-labelledby="ink-title">
    <div class="wrap section">
      <div class="section-heading appearance-heading">
        <div>
          <p class="eyebrow">04 / MAKE YOURSELF AT HOME</p>
          <h2 id="ink-title">
            A calculator you’ll
            <br />
            enjoy picking up.
          </h2>
        </div>
        <p>
          Choose Graphite or Paper & Ink, in light or dark. Follow your system’s
          appearance, or try wallpaper colours on supported Android 12+ devices.
        </p>
      </div>
      <div class="appearance-grid">
        {appearances.map((appearance) => (
          <figure class="appearance-card">
            <Image
              src={appearance.image}
              alt={`Sumi in ${appearance.label} ${appearance.mode.startsWith('Light') ? 'Light' : 'Dark'}, showing (√2 + √3)² = 5 + 2√6`}
              widths={[300, 480, 600]}
              sizes="(max-width: 767px) 220px, (max-width: 1023px) 190px, 240px"
              width={240}
              loading="lazy"
            />
            <figcaption>
              <strong>{appearance.label}</strong>
              <span>{appearance.mode}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="founder-section section wrap" aria-labelledby="founder-title">
    <div>
      <p class="eyebrow">A NOTE FROM THE MAKER</p>
      <h2 id="founder-title">
        A familiar tool.
        <br />A new home.
      </h2>
    </div>
    <div class="founder-copy">
      <p>
        I’ve used a physical scientific calculator since high school. I loved
        having a familiar tool I could reach for, but I didn’t want to carry
        another device everywhere.
      </p>
      <p>
        I made Sumi to bring that feeling to my phone, with an interface I enjoy
        using. I hope it finds a place in your day, too.
      </p>
      <span class="founder-signature">
        Tomu Ozawa <span>Creator of Sumi</span>
      </span>
    </div>
  </section>

  <section class="section wrap guides-section" aria-labelledby="guides-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A GOOD PLACE TO START</p>
        <h2 id="guides-title">
          A little help.
          <br />
          Then you’re away.
        </h2>
      </div>
      <a class="text-link" href="/guides/">
        All guides <span aria-hidden="true">↗</span>
      </a>
    </div>
    <GuideCards />
  </section>

  <section class="faq-section wrap" aria-labelledby="faq-title">
    <div>
      <p class="eyebrow">GOOD QUESTIONS</p>
      <h2 id="faq-title">
        A few things
        <br />
        to know.
      </h2>
      <a href="/support/" class="text-link">
        Help & support <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="faq-list">
      <details>
        <summary>
          Is Sumi really free?<span aria-hidden="true">+</span>
        </summary>
        <p>
          Yes. Every calculator feature is free, with no ads or subscriptions.
          Optional one-time tips in Settings → Support Sumi help support
          development. Tips unlock nothing.
        </p>
      </details>
      <details>
        <summary>
          Does it work without the internet?<span aria-hidden="true">+</span>
        </summary>
        <p>
          Calculations work completely offline. There’s no account to create.
          Store purchases and online help need an internet connection.
        </p>
      </details>
      <details>
        <summary>
          Can I get Sumi on iPhone?<span aria-hidden="true">+</span>
        </summary>
        <p>
          Sumi is available on Android now. The iPhone version is coming soon;
          we’ll add the App Store link here when it’s available.
        </p>
      </details>
      <details>
        <summary>
          Why do some answers stay as fractions?
          <span aria-hidden="true">+</span>
        </summary>
        <p>
          Sumi keeps exact answers where supported. After calculating, tap S⇔D
          to switch to a decimal.{' '}
          <a href="/guides/exact-answers/">Learn about exact answers.</a>
        </p>
      </details>
      <details>
        <summary>
          Does Sumi collect my data?<span aria-hidden="true">+</span>
        </summary>
        <p>
          The app has no advertising or analytics. Sumi stores calculations and
          preferences on your device.{' '}
          <a href="/privacy/">
            Read about local storage and platform services.
          </a>
        </p>
      </details>
    </div>
  </section>
  <FinalDownload campaign="home" />
  <div class="mobile-download" data-mobile-download hidden>
    <DownloadButton campaign="home" compact />
    <span>
      Free.
      <br />
      No ads.
    </span>
  </div>
  <script>
    const heroDownload = document.querySelector('#hero-download');
    const bar = document.querySelector<HTMLElement>('[data-mobile-download]');
    if (heroDownload && bar && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        bar.hidden =
          entry.isIntersecting || entry.boundingClientRect.bottom > 0;
      });
      observer.observe(heroDownload);
      document.body.classList.add('has-mobile-download');
    }
  </script>
</SiteLayout>
