---
import { Image } from 'astro:assets';
import QRCode from 'qrcode';
import SiteLayout from '../layouts/SiteLayout.astro';
import DownloadButton from '../components/DownloadButton.astro';
import editing from '../assets/editing.webp';
import { site } from '../data/site';
const qr = await QRCode.toString(`${site.origin}/download/`, {
  type: 'svg',
  margin: 2,
  color: { dark: '#1B1917', light: '#FFFDF9' },
});
---

<SiteLayout
  title="Download Sumi — Free Scientific Calculator for Android"
  description="Get Sumi on Google Play. A free, offline scientific calculator with exact answers, textbook input and no ads. iPhone coming soon."
>
  <section class="download-page wrap">
    <div>
      <p class="eyebrow">GOOD MATHS. GREAT COMPANY.</p>
      <h1>
        Your next
        <br />
        calculator.
        <br />
        <span>Right here.</span>
      </h1>
      <p class="page-intro">
        Textbook-style maths. Exact answers. No ads.
        <br />
        Meet Sumi, your free scientific calculator.
      </p>
      <DownloadButton campaign="download" />
      <p class="coming-soon">Available on Android. iPhone coming soon.</p>
      <div class="qr-block">
        <div
          class="qr-code"
          role="img"
          aria-label="QR code linking to the Sumi download page"
          set:html={qr}
        />
        <div>
          <h2>On your computer?</h2>
          <p>
            Scan with your Android phone
            <br />
            to open this download page.
          </p>
        </div>
      </div>
      <p class="download-reassurance">
        No account. No subscription. Works offline.
        <br />
        An optional tip jar supports development; all features stay free.
      </p>
    </div>
    <div class="download-visual">
      <Image
        src={editing}
        alt="Sumi’s scientific keypad and textbook expression display"
        widths={[360, 600]}
        sizes="(max-width: 767px) 230px, 290px"
        width={290}
        loading="eager"
      />
      <span class="download-visual-caption">A little more space to think.</span>
    </div>
  </section>
</SiteLayout>
