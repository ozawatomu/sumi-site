---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import DownloadButton from '../../components/DownloadButton.astro';
import GuideCards from '../../components/GuideCards.astro';
import { site } from '../../data/site';
export async function getStaticPaths() {
  return (await getCollection('guides')).map((guide) => ({
    params: { id: guide.id },
    props: { guide },
  }));
}
interface Props {
  guide: CollectionEntry<'guides'>;
}
const { guide }: Props = Astro.props;
const { Content } = await render(guide);
const url = `${site.origin}/guides/${guide.id}/`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.data.title,
    description: guide.data.description,
    datePublished: guide.data.publishedDate.toISOString(),
    author: { '@type': 'Person', name: 'Tomu Ozawa' },
    mainEntityOfPage: url,
    image: `${site.origin}/img/guides/${guide.id}.webp`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Sumi', item: site.origin },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Guides',
        item: `${site.origin}/guides/`,
      },
      { '@type': 'ListItem', position: 3, name: guide.data.title, item: url },
    ],
  },
];
---

<SiteLayout
  title={`${guide.data.title} — Sumi Guides`}
  description={guide.data.description}
  structuredData={structuredData}
>
  <article class="guide-article wrap">
    <header class="article-heading">
      <a href="/guides/" class="text-link">
        <span aria-hidden="true">←</span> The Sumi notebook
      </a>
      <h1>{guide.data.title}</h1>
      <div class="article-download">
        <DownloadButton
          campaign={`guide_${guide.id.replaceAll('-', '_')}`}
          compact
        />
        <p>iPhone coming soon.</p>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <section class="section related-guides wrap" aria-labelledby="related-title">
    <p class="eyebrow">KEEP EXPLORING</p>
    <h2 id="related-title">
      Another page
      <br />
      in the notebook.
    </h2>
    <GuideCards exclude={guide.id} />
  </section>
</SiteLayout>
