---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Page Not Found — Sumi"
  description="This page could not be found. Return to Sumi’s home page or find help in the guides."
  noindex
>
  <section class="not-found wrap">
    <p class="eyebrow">404 — AN UNKNOWN</p>
    <h1>
      This one
      <br />
      <span>doesn’t add up.</span>
    </h1>
    <p>
      We couldn’t find that page.
      <br />
      Let’s get you back to familiar ground.
    </p>
    <a class="download-button" href="/">
      Back to Sumi <span aria-hidden="true">↗</span>
    </a>
    <a class="text-link" href="/support/">
      Get support
    </a>
  </section>
</SiteLayout>
