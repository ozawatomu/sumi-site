---
import { Image } from 'astro:assets';
import DownloadButton from './DownloadButton.astro';
import solve from '../assets/solve.png';
---

<section class="power-section section wrap" aria-labelledby="power-title">
  <header class="power-heading">
    <p class="eyebrow">02 — SMALL APP. SERIOUS MATHS.</p>
    <h2 id="power-title">
      For the problems
      <br />
      worth solving.
    </h2>
    <p class="power-intro">
      Solve equations, calculate integrals and convert units with Sumi’s free
      scientific calculator for Android.
    </p>
  </header>

  <div class="power-grid">
    <article class="power-card solver-card" aria-labelledby="solver-title">
      <div class="solver-copy">
        <p class="eyebrow">EQUATION SOLVING</p>
        <h3 id="solver-title">Find your unknown.</h3>
        <p class="power-description">
          Give SOLVE an equation and a starting estimate. Find a numerical value
          of X and check the residual.
        </p>
      </div>
      <div class="solver-screen">
        <Image
          src={solve}
          alt="Sumi numerically solves X² = 2, showing X = 1.414213562 and residual L−R = 0"
          widths={[400, 600, 824]}
          sizes="(max-width: 767px) calc(100vw - 82px), (max-width: 1023px) 45vw, 520px"
          width={824}
          loading="lazy"
        />
      </div>
      <a class="text-link solver-guide" href="/guides/solve-equations/">
        See how to solve equations <span aria-hidden="true">↗</span>
      </a>
    </article>

    <article class="power-card calculus-card" aria-labelledby="calculus-title">
      <p class="eyebrow">CALCULUS</p>
      <div class="power-math">
        <math aria-label="The integral of x squared from zero to three equals nine"><mrow><msubsup><mo>∫</mo><mn>0</mn><mn>3</mn></msubsup><msup><mi>x</mi><mn>2</mn></msup><mi>d</mi><mi>x</mi><mo>=</mo><mn class="math-result">9</mn></mrow></math>
      </div>
      <h3 id="calculus-title">A little higher thinking.</h3>
      <p class="power-description">
        Definite integrals, numerical derivatives and finite sums, laid out like
        your textbook.
      </p>
    </article>

    <article
      class="power-card constants-card"
      aria-labelledby="constants-title"
    >
      <p class="eyebrow">CONSTANTS & CONVERSIONS</p>
      <div class="constants-art">
        <div class="constant-example">
          <span class="sr-only">Speed of light:</span>
          <span class="constant-symbol" aria-hidden="true">
            c<sub>0</sub> <span class="unit">=</span>
          </span>
          <span class="constant-value">
            299 792 458 <span class="unit">m/s</span>
          </span>
        </div>
        <div class="conversion-example">
          <span>
            68 <span class="unit">°F</span>
          </span>
          <span class="conversion-arrow" aria-hidden="true">
            →
          </span>
          <span class="sr-only">equals</span>
          <span>
            20 <span class="unit">°C</span>
          </span>
        </div>
      </div>
      <h3 id="constants-title">Less looking things up.</h3>
      <p class="power-description">
        40 scientific constants and 40 unit conversions, ready when you need
        them.
      </p>
    </article>
  </div>

  <div class="power-download">
    <DownloadButton campaign="home_power" />
    <p>Free. No ads. Works offline.</p>
  </div>
</section>

<style>
  .power-section {
    padding-top: 0;
  }
  .power-heading {
    margin-bottom: 36px;
  }
  .power-heading > .eyebrow {
    font-size: 0.875rem;
  }
  .power-intro {
    max-width: 580px;
    margin-top: 22px;
    font-size: 1.0625rem;
    color: var(--muted);
  }
  .power-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 24px;
  }
  .power-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 32px;
    border: 1px solid var(--rule);
    border-radius: 20px;
    background: var(--surface);
  }
  .power-card .eyebrow {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .power-card h3 {
    font-size: clamp(1.375rem, 2vw, 1.625rem);
    line-height: 1.25;
    letter-spacing: -0.045em;
  }
  .power-description {
    margin-top: 12px;
    color: var(--muted);
    font-size: 1rem;
  }
  .solver-card {
    grid-row: span 2;
    padding: 36px;
    background: var(--ink);
    border-color: var(--ink);
    color: var(--surface);
  }
  .solver-card .eyebrow,
  .solver-card .power-description {
    color: #cdc6bc;
  }
  .solver-card h3 {
    margin-top: 14px;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }
  .solver-copy {
    max-width: 480px;
  }
  .solver-screen {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 824 / 648;
    flex: none;
    margin: 28px auto;
    overflow: hidden;
    border-radius: 12px;
    background: var(--paper);
    box-shadow: 0 16px 36px #00000024;
  }
  .solver-screen > img {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: auto;
  }
  .solver-guide {
    align-self: flex-start;
    margin-top: auto;
    min-height: 44px;
    font-size: 1rem;
    color: var(--surface);
    gap: 16px;
  }
  .solver-guide:hover {
    color: #f2b3a7;
  }
  .solver-guide:focus-visible {
    outline-color: #f2b3a7;
  }
  .power-math {
    container-type: inline-size;
    display: grid;
    place-items: center;
    flex: 1;
    min-height: 140px;
    padding-block: 26px;
  }
  .power-math math {
    font-family: 'Noto Sans Math', serif;
    font-size: min(3.5rem, 13cqi);
  }
  .math-result {
    color: var(--red-text);
  }
  .constants-art {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    padding-block: 26px;
    gap: 20px;
  }
  .constant-example,
  .conversion-example {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .constant-example {
    padding-bottom: 20px;
    border-bottom: 1px solid var(--rule);
  }
  .constant-symbol {
    font-family: 'Noto Sans Math', serif;
    font-size: 1.75rem;
  }
  .constant-symbol sub {
    font-size: 0.6em;
  }
  .constant-value {
    font-size: 1.25rem;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  .unit {
    color: var(--muted);
    font-size: 1rem;
  }
  .conversion-example {
    font-size: 1.75rem;
    font-variant-numeric: tabular-nums;
  }
  .conversion-example > span {
    white-space: nowrap;
  }
  .conversion-arrow {
    color: var(--red-text);
  }
  .power-download {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px 28px;
    margin-top: 36px;
  }
  .power-download > p {
    color: var(--muted);
    font-size: 1rem;
  }
  .power-download :global(.download-button) {
    max-width: 100%;
    font-size: 1rem;
  }
  .power-download :global(.download-button > svg) {
    flex: none;
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .power-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .power-card {
      padding: 28px;
    }
    .solver-card {
      grid-column: 1 / -1;
      grid-row: auto;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 24px;
      align-items: center;
    }
    .solver-screen {
      grid-column: 2;
      grid-row: 1 / 3;
      margin: 0;
    }
    .solver-guide {
      align-self: end;
    }
  }
  @media (max-width: 767px) {
    .power-heading {
      margin-bottom: 28px;
    }
    .power-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .power-card {
      padding: 20px;
    }
    .solver-card {
      grid-row: auto;
    }
    .solver-screen {
      margin-block: 24px;
    }
    .power-download {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-top: 28px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .power-card.is-revealed {
      animation: power-arrive 450ms both;
    }
    .power-card:nth-child(2) {
      animation-delay: 80ms;
    }
    .power-card:nth-child(3) {
      animation-delay: 160ms;
    }
    @keyframes power-arrive {
      from {
        transform: translateY(12px);
      }
      to {
        transform: translateY(0);
      }
    }
  }
</style>

<script>
  const cards = document.querySelectorAll('.power-card');
  if (
    'IntersectionObserver' in window &&
    window.matchMedia('(prefers-reduced-motion: no-preference)').matches
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.1 },
    );
    cards.forEach((card) => observer.observe(card));
  }
</script>
