---
import DownloadButton from './DownloadButton.astro';
interface Props {
  campaign: string;
}
const { campaign } = Astro.props;
---

<section class="final-download wrap" aria-labelledby="download-title">
  <p class="eyebrow">READY WHEN YOU ARE</p>
  <h2 id="download-title">
    Make Sumi
    <br />
    <span>your everyday calculator.</span>
  </h2>
  <p>Familiar tools. Thoughtful design. Always with you.</p>
  <DownloadButton campaign={campaign} />
  <p class="coming-soon">Free. No ads. No account. iPhone coming soon.</p>
</section>
