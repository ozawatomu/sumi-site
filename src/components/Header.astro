---
const path = Astro.url.pathname;
---

<header class="site-header wrap">
  <a class="wordmark" href="/">
    <span class="brand-mark" aria-hidden="true">
      墨
    </span>
    <span>
      sumi<span class="wordmark-dot">.</span>
    </span>
  </a>
  <nav aria-label="Main navigation">
    <a href="/#features">The calculator</a>
    <a
      href="/guides/"
      aria-current={path.startsWith('/guides/') ? 'page' : undefined}
    >
      Guides
    </a>
    <a
      href="/download/"
      class="nav-download"
      aria-current={path === '/download/' ? 'page' : undefined}
    >
      Get Sumi <span aria-hidden="true">↗</span>
    </a>
  </nav>
</header>
